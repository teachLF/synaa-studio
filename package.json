{
  "name": "ai-studio-applet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "clean": "next clean",
    "build:mobile": "set BUILD_MOBILE=true && next build",
    "build:pages": "node scripts/build-pages.js",
    "sync:android": "set BUILD_MOBILE=true && capacitor sync android",
    "apk:debug": "npm run build:mobile && npm run sync:android && cd android && gradlew assembleDebug",
    "apk:copy": "node scripts/copy-apk.js"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@google/genai": "^2.4.0",
    "@hookform/resolvers": "^5.2.1",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^13.4.0",
    "gifenc": "^1.0.3",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "mp4-muxer": "^5.2.2",
    "next": "^15.4.9",
    "postcss": "^8.5.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwind-merge": "^3.3.1",
    "webm-muxer": "^5.1.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.11",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.8",
    "firebase-tools": "^15.0.0",
    "tailwindcss": "4.1.11",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "@firebase/util": true,
    "@google/genai@2.32.0": true,
    "@tailwindcss/oxide": true,
    "protobufjs@7.6.6": true,
    "re2@1.27.2": true
  }
}
